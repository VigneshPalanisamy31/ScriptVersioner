<Window x:Class="ImageManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageManagementApp"
        mc:Ignorable="d"
        Title="Image Management System" Height="600" Width="900"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="White" >
            <Button Name="AddStepBtn" Content="Add Step" Padding="10,5" Margin="5" Click="AddStepBtn_Click" Background="#4CAF50" Foreground="White"/>
            <Button Name="DeleteStepBtn" Content="Delete Selected" Padding="10,5" Margin="5" Click="DeleteStepBtn_Click" Background="#F44336" Foreground="White"/>
            <Button Name="UndoBtn" Content="Undo" Padding="10,5" Margin="5" Click="UndoBtn_Click" Background="#2196F3" Foreground="White"/>
            <Button Name="RedoBtn" Content="Redo" Padding="10,5" Margin="5" Click="RedoBtn_Click" Background="#2196F3" Foreground="White"/>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
            <Button Name="SaveScriptBtn" Content="Save Script" Padding="10,5" Margin="5" Click="SaveScriptBtn_Click" Background="#FF9800" Foreground="White"/>
            <Button Name="CloseScriptBtn" Content="Close Script" Padding="10,5" Margin="5" Click="CloseAppBtn_Click" Background="#9C27B0" Foreground="White"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Steps List -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Steps in Script" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox Name="StepsListBox" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" 
                         Background="White" Padding="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,3" Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ImagePath, StringFormat='Image: {0}'}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="10" Foreground="#FF9800"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- File System Info Panel -->
            <StackPanel Grid.Column="1" Background="White"  Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="File System Info" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Active Images:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Name="ActiveImagesCount" Text="{Binding ActiveImagesCount}" Foreground="#4CAF50"/>

                <TextBlock Text="Pending Deletion:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Name="PendingImagesCount" Text="{Binding PendingImagesCount}" Foreground="#F44336"/>
                <TextBlock Text="(Will be deleted on Close)" FontSize="9" Foreground="Gray"/>

                <TextBlock Text="Total Active Steps:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Name="TotalStepsCount" Text="{Binding Steps.Count}"/>

                <TextBlock Text="Script Status:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Name="ScriptStatus" Text="{Binding ScriptStatus}" Foreground="#2196F3"/>

                <Separator Margin="0,15"/>

                <TextBlock Text="Git Status Preview" FontSize="12" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="(Images not in Assets/Images folder are deleted)" FontSize="9" Foreground="Gray" TextWrapping="Wrap"/>

                <ListBox Name="GitStatusBox" Height="150" Background="#F9F9F9" Padding="5" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Courier New" FontSize="9"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="White" Padding="10">
            <TextBlock Name="StatusText" Text="Ready" Foreground="Gray"/>
        </StatusBar>
    </Grid>
</Window>
